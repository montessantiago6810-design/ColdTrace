# Copy to .env and adjust. .env is git-ignored.

# Docker Compose (compose.yaml)
POSTGRES_USER=coldtrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=coldtrace
POSTGRES_PORT=5432
MQTT_PORT=1883

# Go binaries (internal/platform/config)
COLDTRACE_ENV=local
COLDTRACE_HTTP_ADDR=127.0.0.1:8080
COLDTRACE_LOG_LEVEL=info
COLDTRACE_LOG_FORMAT=text
COLDTRACE_SHUTDOWN_TIMEOUT=10s
COLDTRACE_DATABASE_URL=postgres://coldtrace:change-me-local-only@127.0.0.1:5432/coldtrace?sslmode=disable

# SvelteKit dashboard (web/)
COLDTRACE_API_URL=http://127.0.0.1:8080
